{
  "name": "sns-growth-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply sns-growth-os-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply sns-growth-os-db --remote",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/server.js && node --check src/database/d1-repository.js && node --check dashboard/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
